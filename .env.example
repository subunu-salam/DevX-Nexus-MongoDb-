# ── Storage ──
# Without this the app writes data/db.json, which Render's free tier WIPES on
# every redeploy and on the daily container recycle. Create a free Postgres
# instance on Render and paste its Internal Database URL here for any
# deployment that takes real orders.
DATABASE_URL=

# ── MongoDB (Atlas free M0 works) ──
# When set, all data is stored in MongoDB (collection nexus_state).
# Priority: MSSQL_SERVER > MONGODB_URI > DATABASE_URL > local file.
MONGODB_URI=
MONGODB_DB=devxnexus

# ── SQL Server (MSSQL) ──
# When MSSQL_SERVER is set the app stores everything in this SQL Server
# (database is created on first run, table dbo.nexus_state). Takes priority
# over DATABASE_URL. Never commit the real password — keep it in .env only.
MSSQL_SERVER=
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=
MSSQL_DATABASE=DevXNexus
# 1 = require TLS (Azure SQL). Self-hosted servers usually 0.
MSSQL_ENCRYPT=0
MSSQL_TRUST_CERT=1

# ── DevX Nexus AI Concierge — environment template ──
# Copy to .env and fill in real values. Never commit your real .env.

# Primary LLM — Groq Llama 3.1 (free): https://console.groq.com  (keys start with gsk_)
GROQ_API_KEY=gsk_your-real-groq-key-here

# Optional fallback LLM — OpenAI (used only if GROQ key is absent)
OPENAI_API_KEY=

# Vision model for the unified scanner (product photos + handwritten lists).
# qwen/qwen3.8-27b is Groq's current image model (llama-4-scout was shut down 17 Jul 2026).
VISION_GROQ_MODEL=qwen/qwen3.8-27b
VISION_OPENAI_MODEL=gpt-4o-mini

# Admin dashboard PIN
ADMIN_PIN=1234

# ── Abuse & cost protection (lib/guard.js) ──
# Total assistant calls allowed per day across all visitors. The per-IP limits
# (12/min, 120/hour) are separate and always on.
AI_DAILY_LIMIT=4000
# Voice transcription is billed on audio length, so it gets a tighter ceiling.
VOICE_DAILY_LIMIT=600

# ── Card gateway (lib/integrations.js) ──
# mock (default, records intent without charging) · telr · ngenius · stripe
PAYMENT_DRIVER=mock
# Telr — most UAE supermarkets already bank with them
TELR_STORE_ID=
TELR_AUTH_KEY=
TELR_WEBHOOK_SECRET=
TELR_TEST=1
# Network International (N-Genius)
NGENIUS_API_KEY=
NGENIUS_OUTLET_REF=
# Stripe — simplest if the store has no local acquirer yet
STRIPE_SECRET_KEY=

# ── Customer messaging ──
# mock (default, logs only) · whatsapp · twilio · textbelt
# Keep this as mock/your existing driver to leave normal order notifications unchanged.
MESSAGING_DRIVER=mock

# ── Forgot PIN OTP SMS ──
# textbelt uses the free public key for 1 SMS/day for testing.
# Set OTP_SMS_DRIVER=textbelt to send Forgot PIN OTPs by SMS.
OTP_SMS_DRIVER=mock
TEXTBELT_KEY=textbelt
# WhatsApp Cloud API — what UAE grocery actually uses
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Twilio SMS
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# ── Observability ──
# Errors are captured and exposed on /api/errors regardless. Set a DSN to also
# forward them; the SDK is loaded lazily so it is only needed if you use it.
SENTRY_DSN=
