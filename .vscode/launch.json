{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run DevX Nexus",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Run DevX Nexus (scratch data)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "envFile": "${workspaceFolder}/.env",
      "env": { "DATA_DIR": "${workspaceFolder}/.scratch", "PORT": "3100" },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug the test suite",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/test/run.js",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
